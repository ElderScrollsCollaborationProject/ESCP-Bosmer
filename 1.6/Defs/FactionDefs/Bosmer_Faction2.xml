<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="FactionBase">
        <defName>ESCP_Faction_Court_Silvenar</defName>
        <label>Court of the Silvenar</label>
        <description>Elden Root may hold the crown, but the city of Silvenar in Malabal Tor holds something the Bosmer take more seriously. The Silvenar is the voice of the people and the Green Lady is their strength, and neither one can exist without the other. Their court keeps the Green Pact honest, and has no great fondness for treethanes who forget it.</description>
        <colorSpectrum>
            <li>(0.35, 0.5, 0.25)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Bosmer</pawnSingular>
        <pawnsPlural>Bosmer</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.2</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <canSiege>false</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>Silvenar</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Empire</factionIconPath>
        <techLevel>Medieval</techLevel>
        <fixedName>Court of the Silvenar</fixedName>
        <disallowedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_NineDivines</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Structure_OriginDivinesNine</li>
        </disallowedMemes>
        <allowedCultures>
            <li>ESCP_Culture_Bosmer</li>
        </allowedCultures>

        <royalTitleTags>
            <li>ESCP_Title_Bosmer</li>
        </royalTitleTags>
        <royalFavorLabel>Silvenar's Favor</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>

        <fixedIdeo>true</fixedIdeo>
        <ideoName>The Voice and the Strength</ideoName>
        <ideoDescription>Y'ffre spoke the first names of things and the Bosmer keep faith with those names by leaving the Green alone. The Silvenar speaks for the people and feels what they feel. The Green Lady carries their strength in her body. If either is lost, a new pair must be found, and Valenwood holds its breath until it is done.</ideoDescription>
        <deityPresets>
            <li>
                <nameType><name>Y'ffre</name><type>Spirit of the Now and god of the forest</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityYffre</iconPath>
            </li>
            <li>
                <nameType><name>Auri-El</name><type>Time-Dragon of the elves</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityAuriEl</iconPath>
            </li>
            <li>
                <nameType><name>Baan Dar</name><type>the Bandit God and Pariah</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityBaanDar</iconPath>
            </li>
            <li>
                <nameType><name>Xarxes</name><type>keeper of the gods' histories</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/ESCP_DeityXarxes</iconPath>
            </li>
            <li>
                <nameType><name>Herma-Mora</name><type>the Woodland Man of the old stories</type></nameType>
                <gender>Male</gender>
                <iconPath>UI/Deities/DeityGeneric</iconPath>
            </li>
            <li>
                <nameType><name>Mara</name><type>mother-goddess and love</type></nameType>
                <gender>Female</gender>
                <iconPath>UI/Deities/ESCP_DeityMara</iconPath>
            </li>
        </deityPresets>
        <styles>
            <li>ESCP_Style_Bosmer</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ESCP_Meme_GreenPact</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Bosmer_Child</li>
                    <li>ESCP_Backstory_Bosmer_Citizen</li>
                    <li>ESCP_Backstory_Bosmer_Military</li>
                    <li>ESCP_Backstory_Bosmer_Mage</li>
                </categories>
            </li>
        </backstoryFilters>

        <caravanTraderKinds>
            <li>ESCP_Caravan_Bosmer_Trader</li>
        </caravanTraderKinds>
        <visitorTraderKinds>
            <li>ESCP_Caravan_Bosmer_Trader</li>
        </visitorTraderKinds>
        <baseTraderKinds>
            <li>ESCP_Caravan_Bosmer_Trader</li>
        </baseTraderKinds>

        <allowedArrivalTemperatureRange>-10~55</allowedArrivalTemperatureRange>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0, 35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <pawnGroupMakers>
            <li>
                <kindDef>Combat</kindDef>
                <options>
                    <ESCP_Pawnkind_Bosmer_Melee>10</ESCP_Pawnkind_Bosmer_Melee>
                    <ESCP_Pawnkind_Bosmer_Ranged>12</ESCP_Pawnkind_Bosmer_Ranged>
                    <ESCP_Pawnkind_Bosmer_Mage>4</ESCP_Pawnkind_Bosmer_Mage>
                    <ESCP_Pawnkind_Bosmer_Captain>3</ESCP_Pawnkind_Bosmer_Captain>
                    <ESCP_Pawnkind_Bosmer_Elite>2</ESCP_Pawnkind_Bosmer_Elite>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <ESCP_Pawnkind_Bosmer_Citizen>15</ESCP_Pawnkind_Bosmer_Citizen>
                    <ESCP_Pawnkind_Bosmer_Merchant>6</ESCP_Pawnkind_Bosmer_Merchant>
                    <ESCP_Pawnkind_Bosmer_Noble>4</ESCP_Pawnkind_Bosmer_Noble>
                    <ESCP_Pawnkind_Bosmer_Mage>3</ESCP_Pawnkind_Bosmer_Mage>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <ESCP_Pawnkind_Bosmer_Trader>1</ESCP_Pawnkind_Bosmer_Trader>
                    <ESCP_Pawnkind_Bosmer_Quartermaster>1</ESCP_Pawnkind_Bosmer_Quartermaster>
                </traders>
                <carriers>
                    <Muffalo>6</Muffalo>
                    <Dromedary>5</Dromedary>
                    <Alpaca>3</Alpaca>
                </carriers>
                <guards>
                    <ESCP_Pawnkind_Bosmer_Melee>8</ESCP_Pawnkind_Bosmer_Melee>
                    <ESCP_Pawnkind_Bosmer_Ranged>5</ESCP_Pawnkind_Bosmer_Ranged>
                    <ESCP_Pawnkind_Bosmer_Elite>1</ESCP_Pawnkind_Bosmer_Elite>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <ESCP_Pawnkind_Bosmer_Citizen>8</ESCP_Pawnkind_Bosmer_Citizen>
                    <ESCP_Pawnkind_Bosmer_Melee>10</ESCP_Pawnkind_Bosmer_Melee>
                    <ESCP_Pawnkind_Bosmer_Ranged>8</ESCP_Pawnkind_Bosmer_Ranged>
                    <ESCP_Pawnkind_Bosmer_Mage>4</ESCP_Pawnkind_Bosmer_Mage>
                    <ESCP_Pawnkind_Bosmer_Elite>2</ESCP_Pawnkind_Bosmer_Elite>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>

        <modExtensions Inherit="False">
            <li Class="ESCP_RaceTools.FactionProperties">
                <factionTags>
                    <li>ESCP_Aldmeri</li>
                    <li>ESCP_GreenPact</li>
                </factionTags>
            </li>
            <li Class="ESCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>Court of the Silvenar</newLabel>
            </li>
            <li Class="ESCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="ESCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>ESCP_Enlistment_CourtSilvenar</li>
                </enlistOptionsDefs>
            </li>
            <li Class="ESCP.Ranks.FactionExtension_RankTracks">
                <rankTracks>
                    <li>ESCP_RankTrack_CourtSilvenar</li>
                </rankTracks>
            </li>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Silvenar</li>
                    <li>Greenheart</li>
                    <li>Vulkwasten</li>
                    <li>Moonmont</li>
                    <li>Grahtwood Hollow</li>
                    <li>Reaper's March</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>TropicalRainforest</li>
                    <li>TemperateForest</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
        </modExtensions>
    </FactionDef>

</Defs>
