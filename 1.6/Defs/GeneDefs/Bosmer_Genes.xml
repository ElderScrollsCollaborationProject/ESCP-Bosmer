<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <GeneDef>
        <defName>ESCP_Gene_Bosmer_Beast_Tongue</defName>
        <label>beast tongue</label>
        <description>Y'ffre shaped the Bosmer and the animals of Valenwood from the same story, and they have never entirely stopped speaking the same language. Carriers tame and train animals with ease, and can call a wild animal to fight beside them.</description>
        <iconPath>UI/Icons/Genes/Gene_PsychicBonding</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <displayOrderInCategory>100</displayOrderInCategory>
        <biostatCpx>2</biostatCpx>
        <biostatMet>-2</biostatMet>
        <statOffsets>
            <TameAnimalChance>0.2</TameAnimalChance>
            <TrainAnimalChance>0.2</TrainAnimalChance>
            <AnimalGatherYield>0.1</AnimalGatherYield>
        </statOffsets>
        <abilities>
            <li>AnimalWarcall</li>
        </abilities>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Bosmer_Archers_Eye</defName>
        <label>archer's eye</label>
        <description>Bosmer children shoot before they read, if they read at all. The eye and the arm settle into the habit early, and carriers place arrows where other people only aim them.</description>
        <iconPath>UI/Icons/Genes/Gene_Robust</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <displayOrderInCategory>101</displayOrderInCategory>
        <biostatCpx>1</biostatCpx>
        <biostatMet>-2</biostatMet>
        <statOffsets>
            <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
            <AimingDelayFactor>-0.1</AimingDelayFactor>
        </statOffsets>
    </GeneDef>

    <GeneDef>
        <defName>ESCP_Gene_Bosmer_Forest_Stride</defName>
        <label>forest stride</label>
        <description>Valenwood has few roads and plenty of low branches. Carriers move fast and light across any ground and are hard to catch in a fight.</description>
        <iconPath>UI/Icons/Genes/Gene_PsychicBonding</iconPath>
        <displayCategory>Miscellaneous</displayCategory>
        <displayOrderInCategory>102</displayOrderInCategory>
        <biostatCpx>1</biostatCpx>
        <biostatMet>-1</biostatMet>
        <statOffsets>
            <MoveSpeed>0.3</MoveSpeed>
            <MeleeDodgeChance>4</MeleeDodgeChance>
        </statOffsets>
    </GeneDef>

</Defs>
