<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RoyalTitleDef ParentName="ESCP_Base_Empire_Titles" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>ESCP_Title_Bosmer_Grovekin</defName>
        <label>grovekin</label>
        <description>One of the people of a graht-oak town, entitled to its shade and obliged to mind the Pact.</description>
        <tags>
            <li>ESCP_Title_Bosmer</li>
        </tags>
        <seniority>0</seniority>
        <favorCost>1</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <commonality>1</commonality>
        <allowDignifiedMeditationFocus>False</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>1</permitPointsAwarded>
    </RoyalTitleDef>

    <RoyalTitleDef ParentName="ESCP_Base_Empire_Titles" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>ESCP_Title_Bosmer_Pathfinder</defName>
        <label>pathfinder</label>
        <description>A trusted guide who knows the wandering paths. Treethanes listen when a pathfinder says something is coming.</description>
        <tags>
            <li>ESCP_Title_Bosmer</li>
        </tags>
        <seniority>200</seniority>
        <favorCost>6</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <commonality>1</commonality>
        <allowDignifiedMeditationFocus>True</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>2</permitPointsAwarded>
    </RoyalTitleDef>

    <RoyalTitleDef ParentName="ESCP_Base_Empire_Titles" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>ESCP_Title_Bosmer_Spinner</defName>
        <label>spinner</label>
        <description>A keeper of the old stories. Spinners settle disputes by retelling them until everyone agrees on what happened.</description>
        <tags>
            <li>ESCP_Title_Bosmer</li>
        </tags>
        <seniority>500</seniority>
        <favorCost>10</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <commonality>1</commonality>
        <allowDignifiedMeditationFocus>True</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>3</permitPointsAwarded>
    </RoyalTitleDef>

    <RoyalTitleDef ParentName="ESCP_Base_Empire_Titles" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>ESCP_Title_Bosmer_Treethane</defName>
        <label>treethane</label>
        <description>Lord of a tree and everyone living in it. The office is real enough, though nobody in Valenwood is sure what it actually involves.</description>
        <tags>
            <li>ESCP_Title_Bosmer</li>
        </tags>
        <seniority>900</seniority>
        <favorCost>16</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <commonality>1</commonality>
        <allowDignifiedMeditationFocus>True</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>4</permitPointsAwarded>
