<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Mashed's Bloodmoon</li>
        </mods>
        <match Class="PatchOperationFindMod">
            <mods>
                <li>Ideology</li>
            </mods>
            <match Class="PatchOperationAdd">
                <xpath>Defs/MemeDef[defName="ESCP_Meme_GreenPact"]/requireOne</xpath>
                <value>
                    <li>
                        <li>Mashed_Bloodmoon_LycanthropeReviled</li>
                    </li>
                </value>
            </match>
        </match>
    </Operation>

</Patch>
